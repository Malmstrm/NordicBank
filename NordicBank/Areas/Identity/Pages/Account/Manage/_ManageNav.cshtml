@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<!-- 🛠 Rubrik om du vill behålla den -->
<h6 class="text-muted fw-bold mb-3">
    <i class="bi bi-gear me-1"></i> Account Settings
</h6>

<!-- 💡 Korrekt struktur: card omsluter list-group -->
<div class="card shadow-sm rounded-4 bg-light" style="border: 1px solid #cfd4da;">
    <div class="card-header bg-dark text-white fw-semibold">
        <i class="bi bi-gear me-1"></i> Account Settings
    </div>

    <div class="list-group list-group-flush">
        <a class="list-group-item list-group-item-action text-dark fw-semibold d-flex align-items-center gap-2 @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
            <i class="bi bi-person-gear"></i> Profile
        </a>
        <a class="list-group-item list-group-item-action text-dark fw-semibold d-flex align-items-center gap-2 @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">
            <i class="bi bi-envelope"></i> Email
        </a>
        <a class="list-group-item list-group-item-action text-dark fw-semibold d-flex align-items-center gap-2 @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
            <i class="bi bi-key"></i> Password
        </a>

        @if (hasExternalLogins)
        {
            <a class="list-group-item list-group-item-action text-dark fw-semibold d-flex align-items-center gap-2 @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
                <i class="bi bi-box-arrow-in-right"></i> External Logins
            </a>
        }
    </div>
</div>
