@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Dashboard.cshtml";
    }
}

<div class="container mt-5 mb-5" style="max-width: 720px;">
    <div class="text-center mb-4">
        <h2 class="fw-semibold"><i class="bi bi-person-gear me-2"></i>Manage Your Account</h2>
        <p class="text-muted mb-0">Change your profile, password, and security settings.</p>
    </div>

    <!-- 🔧 Horizontal Navigation -->
    <div class="card shadow-sm mb-4 rounded-4 bg-light" style="border: 1px solid #cfd4da;">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="btn btn-outline-dark @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
                    <i class="bi bi-person-gear me-1"></i> Profile
                </a>
                <a class="btn btn-outline-dark @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">
                    <i class="bi bi-envelope me-1"></i> Email
                </a>
                <a class="btn btn-outline-dark @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
                    <i class="bi bi-key me-1"></i> Password
                </a>
            </div>
        </div>
    </div>

    <!-- 🧾 Main Content -->
    <div class="card p-4 shadow-sm rounded-4 bg-light" style="border: 1px solid #cfd4da;">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}