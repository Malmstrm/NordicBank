@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<form id="profile-form" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label class="form-label fw-semibold" for="Username">Username</label>
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
            <input class="form-control" placeholder="Your username" disabled type="text" id="Username" name="Username" value="@Model.Username">
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold" for="Input_PhoneNumber">Phone Number</label>
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Enter your phone number" type="tel" />
        </div>
        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
    </div>

    <button id="update-profile-button" type="submit" class="btn btn-dark w-100 py-3 rounded-4 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-save2"></i>
        <span class="fw-semibold">Save Changes</span>
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
