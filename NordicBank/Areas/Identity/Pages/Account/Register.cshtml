@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5 mb-5">
    <div class="mx-auto" style="max-width: 640px;">
        <div class="text-center mb-4">
            <h2 class="fw-semibold"><i class="bi bi-person-plus me-2"></i>Register New User</h2>
            <p class="text-muted mb-0">Create a new system user and assign their role.</p>
        </div>

        <div class="card p-4 shadow-sm rounded-4 bg-light" style="border: 1px solid #cfd4da;">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat password" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label mb-2">User Role</label>
                    <div class="d-flex flex-column gap-2">
                        <div class="form-check border rounded-3 p-3 bg-white d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" asp-for="Input.UserRole" type="radio" value="Admin" id="roleAdmin">
                            <label class="form-check-label fw-semibold" for="roleAdmin">
                                <i class="bi bi-shield-lock me-1 text-dark"></i> Admin
                                <span class="d-block text-muted small">Full system access and user management.</span>
                            </label>
                        </div>

                        <div class="form-check border rounded-3 p-3 bg-white d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" asp-for="Input.UserRole" type="radio" value="Cashier" id="roleCashier">
                            <label class="form-check-label fw-semibold" for="roleCashier">
                                <i class="bi bi-cash-coin me-1 text-dark"></i> Cashier
                                <span class="d-block text-muted small">Manages customers and accounts only.</span>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Input.UserRole" class="text-danger small d-block mt-1"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn btn-dark w-100 py-3 rounded-4 d-flex align-items-center justify-content-center gap-2" disabled>
                    <i class="bi bi-person-plus-fill fs-5"></i>
                    <span class="fw-semibold">Register User</span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const form = document.getElementById("registerForm");
        const submitButton = document.getElementById("registerSubmit");

        form.addEventListener("input", () => {
            const isValid = form.checkValidity();
            submitButton.disabled = !isValid;
        });
    </script>
}