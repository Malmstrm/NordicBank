@using NordicBank.ViewModels
@model CustomerDetailsViewModel


<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-10 text-center">
                        <!-- Flag + namn -->
                        <h4 class="mb-3">
                            <img src="https://flagcdn.com/48x36/@(Model.CountryCode.ToLower()).png"
                                 alt="@Model.Country flag"
                                 class="me-2 rounded border" />
                            @Model.FullName
                        </h4>
                    </div>
                </div>
            <dl class="row">
                <dt class="col-sm-4">Customer ID</dt>
                <dd class="col-sm-8">@Model.CustomerId</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.Gender</dd>

                <dt class="col-sm-4">Address</dt>
                <dd class="col-sm-8">@Model.Streetaddress, @Model.City @Model.Zipcode</dd>

                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@Model.Phone</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Emailaddress</dd>

                <dt class="col-sm-4">Birthday</dt>
                <dd class="col-sm-8">@Model.Birthday?.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">National ID</dt>
                <dd class="col-sm-8">@Model.NationalId</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>

                <dt class="col-sm-4">Accounts</dt>
                <dd class="col-sm-8">@Model.NumberOfAccounts</dd>

                <dt class="col-sm-4">Total Balance</dt>
                <dd class="col-sm-8 text-primary fw-semibold">@Model.TotalBalance.ToString("C")</dd>
            </dl>
        </div>
    </div>
</div>