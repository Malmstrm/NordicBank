
@model NordicBank.ViewModels.CustomerDetailsViewModel

<div>
    <h5>@Model.FullName</h5>
    <p><strong>Gender:</strong> @Model.Gender</p>
    <p><strong>Address:</strong> @Model.Streetaddress, @Model.City @Model.Zipcode</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Email:</strong> @Model.Emailaddress</p>
    <p><strong>Birthday:</strong> @(Model.Birthday?.ToString("yyyy-MM-dd"))</p>
    <p><strong>National ID:</strong> @Model.NationalId</p>
    <hr />
    <p><strong>Accounts:</strong> @Model.NumberOfAccounts</p>
    <p><strong>Total Balance:</strong> @Model.TotalBalance.ToString(\"C\")</p>
</div>