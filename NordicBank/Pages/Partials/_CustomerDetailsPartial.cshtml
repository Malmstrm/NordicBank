@using NordicBank.ViewModels;
@model FullCustomerViewModel

<div>
    <p><strong>Customer ID:</strong> @Model.CustomerId</p>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>City:</strong> @Model.City</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>National ID:</strong> @Model.NationalId</p>
    <p><strong>Number of Accounts:</strong> @Model.AccountCount</p>
</div>
