@using NordicBank.ViewModels
@model CustomerDetailsViewModel

<div class="container">
    <div class="text-center mb-4">
        <h4 class="fw-semibold d-flex justify-content-center align-items-center gap-2">
            <img src="https://flagcdn.com/48x36/@(Model.CountryCode.ToLower()).png"
                 alt="@Model.Country flag"
                 class="rounded border shadow-sm" />
            @Model.FullName
        </h4>
        <small class="text-muted">Full customer profile details</small>
    </div>

    <dl class="row gx-4 gy-3">
        <dt class="col-sm-4 text-end">Customer ID</dt>
        <dd class="col-sm-8">@Model.CustomerId</dd>

        <dt class="col-sm-4 text-end">Gender</dt>
        <dd class="col-sm-8">@Model.Gender</dd>

        <dt class="col-sm-4 text-end">Address</dt>
        <dd class="col-sm-8">@Model.Streetaddress, @Model.City @Model.Zipcode</dd>

        <dt class="col-sm-4 text-end">Phone</dt>
        <dd class="col-sm-8">@Model.Phone</dd>

        <dt class="col-sm-4 text-end">Email</dt>
        <dd class="col-sm-8">@Model.Emailaddress</dd>

        <dt class="col-sm-4 text-end">Birthday</dt>
        <dd class="col-sm-8">@Model.Birthday?.ToString("yyyy-MM-dd") ?? "N/A"</dd>

        <dt class="col-sm-4 text-end">National ID</dt>
        <dd class="col-sm-8">@Model.NationalId</dd>

        <dt class="col-sm-4 text-end">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 text-end">Accounts</dt>
        <dd class="col-sm-8">@Model.NumberOfAccounts</dd>

        <dt class="col-sm-4 text-end">Total Balance</dt>
        <dd class="col-sm-8 text-primary fw-semibold">
            @Model.TotalBalance.ToString("C", System.Globalization.CultureInfo.CurrentCulture)
        </dd>
    </dl>
</div>
