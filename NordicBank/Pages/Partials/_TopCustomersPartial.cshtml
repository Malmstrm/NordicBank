@using NordicBank.ViewModels
@model List<TopCustomerViewModel>

<table class="table table-hover table-sm align-middle table-bordered mb-0">
    <thead class="table-dark text-white text-center">
        <tr>
            <th style="width: 50px;"><i class="bi bi-hash"></i></th>
            <th><i class="bi bi-person-circle me-1"></i> Name</th>
            <th><i class="bi bi-geo-alt me-1"></i> City</th>
            <th><i class="bi bi-wallet2 me-1"></i> Total Balance</th>
        </tr>
    </thead>
    <tbody class="text-center">
        @for (int i = 0; i < Model.Count; i++)
        {
            var customer = Model[i];
            <tr>
                <td><strong>@(i + 1)</strong></td>
                <td class="fw-semibold">@customer.Name</td>
                <td>@customer.City</td>
                <td class="fw-semibold text-dark">@customer.TotalBalance.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>