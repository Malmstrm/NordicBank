@page "{id:int}/{customerId:int}"
@model NordicBank.Pages.AccountPage.DetailsModel
@{
    ViewData["Title"] = "Account Details";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-2">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<!-- Account Overview -->
<div class="card mt-4 shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-bank2 me-2"></i>Account Overview</h5>
        <a asp-page="/CustomerPage/Details" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-secondary">← Back to Customer</a>
    </div>

    <div class="card-body">
        <div class="row">
            <!-- Left Column -->
            <div class="col-md-6 border-end">
                <dl class="row">
                    <dt class="col-sm-4">Account ID</dt>
                    <dd class="col-sm-8">@Model.Account.AccountId</dd>

                    <dt class="col-sm-4">Balance</dt>
                    <dd class="col-sm-8 text-primary fw-semibold">@Model.Account.Balance.ToString("C")</dd>

                    <dt class="col-sm-4">Frequency</dt>
                    <dd class="col-sm-8">@Model.Account.Frequency</dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.Account.Created.ToString("yyyy-MM-dd")</dd>
                </dl>
            </div>

            <!-- Right Column: Status + Actions -->
            <div class="col-md-6 d-flex flex-column justify-content-center align-items-center">
                <div class="text-center mb-3">
                    <span class="fw-semibold">Status:</span><br />
                    @if (Model.Account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                    {
                        <span class="badge bg-success mt-1"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger mt-1"><i class="bi bi-x-circle-fill me-1"></i> Inactive</span>
                    }
                </div>

                <div class="d-grid gap-2 w-100 px-3 mt-2">
                    @if (Model.Account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                    {
                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Account.AccountId"
                              onsubmit="return confirm('Are you sure you want to deactivate this account?');">
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="bi bi-pause-circle me-1"></i> Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Activate" asp-route-id="@Model.Account.AccountId"
                              onsubmit="return confirm('Are you sure you want to activate this account?');">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-play-circle me-1"></i> Activate
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Account Actions -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Account Actions</h5>
    </div>
    <div class="card-body">
        <div class="d-flex flex-column flex-md-row gap-3">
            <!-- Deposit / Withdraw -->
            <form method="post" class="flex-fill">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-cash-coin"></i></span>
                    <input name="amount" type="number" step="0.01" min="0" class="form-control" placeholder="Enter amount" required />
                    <button type="submit" name="action" value="Deposit" class="btn btn-outline-success">
                        <i class="bi bi-plus-circle"></i> Deposit
                    </button>
                    <button type="submit" name="action" value="Withdraw" class="btn btn-outline-danger">
                        <i class="bi bi-dash-circle"></i> Withdraw
                    </button>
                </div>
            </form>

            <!-- Transfer -->
            <form method="post" asp-page-handler="Transfer" asp-route-id="@Model.Account.AccountId" class="flex-fill">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-send"></i></span>
                    <input name="amount" type="number" step="0.01" min="0" class="form-control" placeholder="Amount" required />
                    <input name="toAccountId" type="number" class="form-control" placeholder="To Account ID" required />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left-right"></i> Transfer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Transactions -->
<div class="card mb-5">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Transactions</h5>
    </div>
    <div class="card-body">
        @if (Model.Transactions.Count == 0)
        {
            <p class="text-muted">No transactions yet.</p>
        }
        else
        {
            <table class="table table-striped table-hover table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody id="transactionTableBody">
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                            <td>@t.Type</td>
                            <td class="fw-semibold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                @if (t.Amount >= 0)
                                {
                                    <i class="bi bi-arrow-down-circle me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-up-circle me-1"></i>
                                }
                                @t.Amount.ToString("C")
                            </td>
                            <td>@t.Balance.ToString("C")</td>
                            <td>@t.Description</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.TotalCount > 20)
            {
                <div class="text-center mt-3">
                    <button id="load-more-btn"
                            data-account-id="@Model.Account.AccountId"
                            data-skip="20"
                            data-total="@Model.TotalCount"
                            class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-down-square"></i> Load more
                    </button>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("load-more-btn")?.addEventListener("click", async function () {
            const btn = this;
            const accountId = btn.dataset.accountId;
            let skip = parseInt(btn.dataset.skip);
            const total = parseInt(btn.dataset.total);

            try {
                const response = await fetch(`?handler=FetchTransactions&accountId=${accountId}&skip=${skip}`);
                const html = await response.text();

                if (html.trim() !== "") {
                    document.getElementById("transactionTableBody").insertAdjacentHTML("beforeend", html);
                    skip += 20;
                    btn.dataset.skip = skip;

                    if (skip >= total) {
                        btn.style.display = "none";
                    }
                } else {
                    btn.disabled = true;
                    btn.textContent = "No more transactions";
                }
            } catch (error) {
                console.error("Failed to load transactions:", error);
                btn.disabled = true;
                btn.textContent = "Error loading transactions";
            }
        });
    </script>
}
