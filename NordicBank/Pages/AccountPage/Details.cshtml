@page "{id:int}/{customerId:int}"
@model NordicBank.Pages.AccountPage.DetailsModel
@{
}
@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-2">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}
<div class="card mt-4 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Account Information</h5>
        <a asp-page="/CustomerPage/Details" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-secondary">← Back to Customer</a>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Left Column -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Account ID</dt>
                    <dd class="col-sm-8">@Model.Account.AccountId</dd>

                    <dt class="col-sm-4">Balance</dt>
                    <dd class="col-sm-8">@Model.Account.Balance.ToString("C")</dd>

                    <dt class="col-sm-4">Frequency</dt>
                    <dd class="col-sm-8">@Model.Account.Frequency</dd>
                </dl>
            </div>

            <!-- Right Column -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.Account.Created.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                        {
                            <span class="badge bg-success">✅ Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">🛑 Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-4 d-flex flex-wrap justify-content-end gap-2">
            @if (Model.Account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
            {
                <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Account.AccountId" onsubmit="return confirm('Are you sure you want to deactivate this account?');">
                    <button type="submit" class="btn btn-warning">🛑 Deactivate</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Activate" asp-route-id="@Model.Account.AccountId" onsubmit="return confirm('Are you sure you want to activate this account?');">
                    <button type="submit" class="btn btn-success">✅ Activate</button>
                </form>
            }
        </div>
    </div>
</div>

<!-- Deposit/Withdraw Actions -->
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Account Actions</h5>
    </div>
    <div class="card-body">
        <div class="d-flex gap-3">
            <!-- Deposit / Withdraw -->
            <form method="post" class="mb-3">
                <div class="input-group">
                    <span class="input-group-text">💰</span>
                    <input name="amount" type="number" step="0.01" min="0" class="form-control" placeholder="Enter amount" required />
                    <button type="submit" name="action" value="Deposit" class="btn btn-outline-success">➕ Deposit</button>
                    <button type="submit" name="action" value="Withdraw" class="btn btn-outline-danger">➖ Withdraw</button>
                </div>
            </form>

            <!-- Transfer -->
            <form method="post" asp-page-handler="Transfer" asp-route-id="@Model.Account.AccountId">
                <div class="input-group">
                    <span class="input-group-text">💸</span>
                    <input name="amount" type="number" step="0.01" min="0" class="form-control" placeholder="Amount" required />
                    <span class="input-group-text">➡️</span>
                    <input name="toAccountId" type="number" class="form-control" placeholder="To Account ID" required />
                    <button type="submit" class="btn btn-outline-primary">Transfer</button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Transactions -->
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Transactions</h5>

    </div>

    <div class="card-body">
        @if (Model.Transactions.Count == 0)
        {
            <p class="text-muted">No transactions yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody id="transactionTableBody">
                    @foreach (var t in Model.Transactions)
                    {
                        <partial name="_TransactionRow" model="t" />
                    }
                </tbody>

            </table>
            @if (Model.TotalCount > 20)
            {
                <div class="text-center mt-3">
                    <button id="load-more-btn"
                            data-account-id="@Model.Account.AccountId"
                            data-skip="20"
                            data-total="@Model.TotalCount"
                            class="btn btn-outline-secondary">
                        Load more
                    </button>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("load-more-btn")?.addEventListener("click", async function () {
            const btn = this;
            const accountId = btn.dataset.accountId;
            let skip = parseInt(btn.dataset.skip);
            const total = parseInt(btn.dataset.total); // 👈 Lägg till totalen som data-attribut i knappen!

            try {
                const response = await fetch(`?handler=FetchTransactions&accountId=${accountId}&skip=${skip}`);
                const html = await response.text();

                if (html.trim() !== "") {
                    document.getElementById("transactionTableBody").insertAdjacentHTML("beforeend", html);
                    skip += 20;
                    btn.dataset.skip = skip;

                    // ✅ Dölj knappen när alla är laddade
                    if (skip >= total) {
                        btn.style.display = "none";
                    }
                } else {
                    // 🔒 Fallback
                    btn.disabled = true;
                    btn.textContent = "No more transactions";
                }
            } catch (error) {
                console.error("Failed to load transactions:", error);
                btn.disabled = true;
                btn.textContent = "Error loading transactions";
            }
        });
    </script>
}
