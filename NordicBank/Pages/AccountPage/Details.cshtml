@page "{id:int}/{customerId:int}"
@model NordicBank.Pages.AccountPage.DetailsModel
@{
    ViewData["Title"] = "Account Details";
}

<div class="card mt-4 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Account Information</h5>
        <a asp-page="/CustomerPage/Details" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-secondary">← Back to Customer</a>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Left Column -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Account ID</dt>
                    <dd class="col-sm-8">@Model.Account.AccountId</dd>

                    <dt class="col-sm-4">Balance</dt>
                    <dd class="col-sm-8">@Model.Account.Balance.ToString("C")</dd>

                    <dt class="col-sm-4">Frequency</dt>
                    <dd class="col-sm-8">@Model.Account.Frequency</dd>
                </dl>
            </div>

            <!-- Right Column -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.Account.Created.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                        {
                            <span class="badge bg-success">✅ Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">🛑 Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-4 d-flex flex-wrap justify-content-end gap-2">
            @if (Model.Account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
            {
                <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Account.AccountId" onsubmit="return confirm('Are you sure you want to deactivate this account?');">
                    <button type="submit" class="btn btn-warning">🛑 Deactivate</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Activate" asp-route-id="@Model.Account.AccountId" onsubmit="return confirm('Are you sure you want to activate this account?');">
                    <button type="submit" class="btn btn-success">✅ Activate</button>
                </form>
            }
        </div>
    </div>
</div>

<!-- Deposit/Withdraw Actions -->
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Account Actions</h5>
    </div>
    <div class="card-body">
        <div class="d-flex gap-3">
            <form method="post" asp-page-handler="Deposit" asp-route-id="@Model.Account.AccountId">
                <div class="input-group">
                    <input name="amount" type="number" step="0.01" min="0" class="form-control" placeholder="Amount to deposit" required />
                    <button type="submit" class="btn btn-outline-success">➕ Deposit</button>
                </div>
            </form>

            <form method="post" asp-page-handler="Withdraw" asp-route-id="@Model.Account.AccountId">
                <div class="input-group">
                    <input name="amount" type="number" step="0.01" min="0" class="form-control" placeholder="Amount to withdraw" required />
                    <button type="submit" class="btn btn-outline-danger">➖ Withdraw</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Transactions -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Latest 10 Transactions</h5>
    </div>
    <div class="card-body">
        @if (Model.Transactions.Count == 0)
        {
            <p class="text-muted">No transactions yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                            <td>@t.Type</td>
                            <td style="color:@(t.Amount >= 0 ? "green" : "red")">@t.Amount.ToString("C")</td>
                            <td>@t.Balance.ToString("C")</td>
                            <td>@t.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}