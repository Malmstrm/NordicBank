@page
@model NordicBank.Pages.AccountSummary.IndexModel
@{
}
@{
    ViewData["Title"] = "Account Summary";
}

<h2 class="mb-4">📋 Kontosammanställning</h2>

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Kontonummer</th>
            <th>Ägare</th>
            <th>Skapad</th>
            <th>Saldo</th>
            <th>Frekvens</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model.Accounts)
        {
            <tr>
                <td>@account.AccountId</td>
                <td>@account.CustomerName</td>
                <td>@account.Created.ToString("yyyy-MM-dd")</td>
                <td>@account.Balance.ToString("C0")</td>
                <td>@account.Frequency</td>
                <td>
                    @if (account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else if (account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Inactive)
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                else if (account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Suspended)
                    {
                        <span class="badge bg-danger">Suspended</span>
                    }
                    else
                    {
                        <span class="badge bg-dark">Unknown</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>