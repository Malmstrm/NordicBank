@page
@model NordicBank.Pages.AccountSummary.IndexModel
@{
    ViewData["Title"] = "Account Summary";
}

<div class="card shadow-sm mt-4 mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-bank2 me-2"></i>Account Summary</h5>
    </div>

    <div class="card-body">
        <!-- 🔍 Search -->
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by customer name..." />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>

        <!-- 📋 Table -->
        <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle table-striped">
                <thead class="table-light text-center">
                    <tr>
                        <th>
                            <a asp-page="./Index" asp-route-sortColumn="AccountId" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Model.SearchTerm">Account #</a>
                        </th>
                        <th>
                            <a asp-page="./Index" asp-route-sortColumn="CustomerName" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Model.SearchTerm">Customer</a>
                        </th>
                        <th>Created</th>
                        <th>
                            <a asp-page="./Index" asp-route-sortColumn="Balance" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Model.SearchTerm">Balance</a>
                        </th>
                        <th>Frequency</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in Model.Accounts)
                    {
                        <tr>
                            <td class="text-center">@acc.AccountId</td>
                            <td>@acc.CustomerName</td>
                            <td>@acc.Created.ToString("yyyy-MM-dd")</td>
                            <td>@acc.Balance.ToString("C0")</td>
                            <td>@acc.Frequency</td>
                            <td>
                                @if (acc.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (acc.AccountStatus == DataAccessLayer.Enums.AccountStatus.Inactive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (acc.AccountStatus == DataAccessLayer.Enums.AccountStatus.Suspended)
                                {
                                    <span class="badge bg-danger">Suspended</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">Unknown</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 📄 Pagination -->
        <nav aria-label="Account pagination">
            <ul class="pagination justify-content-center mt-3">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-pageNo="@(Model.CurrentPage - 1)" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm">
                            « Previous
                        </a>
                    </li>
                }

                <li class="page-item disabled">
                    <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                </li>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-pageNo="@(Model.CurrentPage + 1)" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm">
                            Next »
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>