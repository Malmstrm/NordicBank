@page
@model NordicBank.Pages.AccountSummary.IndexModel
@{
    ViewData["Title"] = "Account Summary";
}

<div class="card shadow-sm mt-4 mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-bank2 me-2"></i>Account Overview</h5>
    </div>

    <div class="card-body">
        <!-- 🔍 Search -->
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by customer name..." />
                <button type="submit" class="btn btn-outline-dark">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>

        <!-- 📋 Table -->
        <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle table-striped">
                <thead class="table-light text-center">
                    <tr>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="AccountId"
                               asp-route-sortOrder="@(Model.SortColumn == "AccountId" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               class="text-decoration-none text-dark d-flex justify-content-center align-items-center gap-1">
                                ID
                                @if (Model.SortColumn == "AccountId")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="CustomerName"
                               asp-route-sortOrder="@(Model.SortColumn == "CustomerName" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               class="text-decoration-none text-dark d-flex justify-content-center align-items-center gap-1">
                                Customer
                                @if (Model.SortColumn == "CustomerName")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="Created"
                               asp-route-sortOrder="@(Model.SortColumn == "Created" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               class="text-decoration-none text-dark d-flex justify-content-center align-items-center gap-1">
                                Created
                                @if (Model.SortColumn == "Created")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="Balance"
                               asp-route-sortOrder="@(Model.SortColumn == "Balance" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               class="text-decoration-none text-dark d-flex justify-content-center align-items-center gap-1">
                                Balance
                                @if (Model.SortColumn == "Balance")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            Frequency
                        </th>
                        <th>
                            Actions
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in Model.Accounts)
                    {
                        <tr>
                            <td class="text-center">@acc.AccountId</td>
                            <td>@acc.CustomerName</td>
                            <td>@acc.Created.ToString("yyyy-MM-dd")</td>
                            <td>@acc.Balance.ToString("C0")</td>
                            <td>@acc.Frequency</td>
                            <td class="text-center d-flex justify-content-center align-items-center gap-3">
                                <a asp-page="/AccountPage/Details" asp-route-id="@acc.AccountId" asp-route-customerId="@acc.CustomerId"
                                   class="text-dark" title="View account">
                                    <i class="bi bi-credit-card fs-5"></i>
                                </a>

                                <a asp-page="/CustomerPage/Details" asp-route-id="@acc.CustomerId"
                                   class="text-dark" title="View customer">
                                    <i class="bi bi-eye-fill me-2 fs-5"></i>
                                </a>

                                @switch (acc.AccountStatus)
                                {
                                    case DataAccessLayer.Enums.AccountStatus.Active:
                                        <i class="bi bi-check-circle-fill text-success fs-5" title="Active"></i>
                                        break;
                                    case DataAccessLayer.Enums.AccountStatus.Inactive:
                                        <i class="bi bi-pause-circle-fill text-warning fs-5" title="Inactive"></i>
                                        break;
                                    case DataAccessLayer.Enums.AccountStatus.Suspended:
                                        <i class="bi bi-slash-circle-fill text-danger fs-5" title="Suspended"></i>
                                        break;
                                    default:
                                        <i class="bi bi-question-circle-fill text-secondary fs-5" title="Unknown"></i>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 📄 Pagination -->
        <nav aria-label="Account pagination">
            <ul class="pagination justify-content-center mt-3">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-pageNo="@(Model.CurrentPage - 1)" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm">
                            « Previous
                        </a>
                    </li>
                }

                <li class="page-item disabled">
                    <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                </li>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-pageNo="@(Model.CurrentPage + 1)" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm">
                            Next »
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>