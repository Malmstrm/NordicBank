@page
@model NordicBank.Pages.AccountSummary.IndexModel
@{
    ViewData["Title"] = "Manage Accounts";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-4">
        <h2 class="fw-semibold"><i class="bi bi-bank2 me-2"></i>Manage Accounts</h2>
        <p class="text-muted mb-0">View and manage all customer accounts.</p>
    </div>

    <!-- 🔍 Search -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by customer name..." />
            <button type="submit" class="btn btn-outline-dark">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </form>

    <!-- 📋 Account List -->
    <div class="card shadow-sm rounded-4 bg-light" style="border: 1px solid #cfd4da;">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-page="./Index" asp-route-sortColumn="AccountId"
                               asp-route-sortOrder="@(Model.SortColumn == "AccountId" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                ID
                                @if (Model.SortColumn == "AccountId")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index" asp-route-sortColumn="CustomerName"
                               asp-route-sortOrder="@(Model.SortColumn == "CustomerName" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                Customer
                                @if (Model.SortColumn == "CustomerName")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>Created</th>
                        <th>
                            <a asp-page="./Index" asp-route-sortColumn="Balance"
                               asp-route-sortOrder="@(Model.SortColumn == "Balance" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                Balance
                                @if (Model.SortColumn == "Balance")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>Frequency</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in Model.Accounts)
                    {
                        <tr>
                            <td>@acc.AccountId</td>
                            <td>@acc.CustomerName</td>
                            <td>@acc.Created.ToString("yyyy-MM-dd")</td>
                            <td>@acc.Balance.ToString("C0")</td>
                            <td>@acc.Frequency</td>
                            <td>
                                @switch (acc.AccountStatus)
                                {
                                    case DataAccessLayer.Enums.AccountStatus.Active:
                                        <i class="bi bi-check-circle-fill text-dark fs-5" title="Active"></i>
                                        break;
                                    case DataAccessLayer.Enums.AccountStatus.Inactive:
                                        <i class="bi bi-pause-circle-fill text-dark fs-5" title="Inactive"></i>
                                        break;
                                    case DataAccessLayer.Enums.AccountStatus.Suspended:
                                        <i class="bi bi-slash-circle-fill text-danger fs-5" title="Suspended"></i>
                                        break;
                                    default:
                                        <i class="bi bi-question-circle-fill text-secondary fs-5" title="Unknown"></i>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-page="/AccountPage/Details" asp-route-id="@acc.AccountId" asp-route-customerId="@acc.CustomerId"
                                       class="btn btn-sm btn-outline-dark rounded-3" title="View account">
                                        <i class="bi bi-credit-card"></i>
                                    </a>
                                    <a asp-page="/CustomerPage/Details" asp-route-id="@acc.CustomerId"
                                       class="btn btn-sm btn-outline-secondary rounded-3" title="View customer">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 📄 Pagination -->
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link text-dark" asp-page="./Index"
                       asp-route-pageNo="@(Model.CurrentPage - 1)"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm">
                        « Previous
                    </a>
                </li>
            }

            <li class="page-item disabled">
                <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
            </li>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link text-dark" asp-page="./Index"
                       asp-route-pageNo="@(Model.CurrentPage + 1)"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm">
                        Next »
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>
