@page
@using System.Text.Json
@model NordicBank.Pages.Report.IndexModel
@{
    ViewData["Title"] = "Summary Reports";
    Layout = "_Dashboard";
}

<!-- 🏦 Hero -->
<div class="container text-center mt-5 mb-4">
    <h1 class="display-5 fw-bold"><i class="bi bi-bar-chart-line me-2"></i>Summary Reports</h1>
    <p class="lead text-muted">Get a full overview of customer and capital distribution across countries.</p>
</div>

<!-- 📈 Summary Cards -->
<div class="container">
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-white shadow-sm border-start border-4 border-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Active (90 days)</h6>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CustomerActivity.ActiveCustomers</h4>
                        </div>
                        <i class="bi bi-calendar-check fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-white shadow-sm border-start border-4 border-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Inactive (12+ months)</h6>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CustomerActivity.InactiveCustomers</h4>
                        </div>
                        <i class="bi bi-person-x fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-white shadow-sm border-start border-4 border-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">New Customers (30 days)</h6>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CustomerActivity.NewCustomers</h4>
                        </div>
                        <i class="bi bi-person-plus fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 📊 Capital per country -->
<div class="container mb-4">
    <div class="card shadow-sm border-start border-4 border-dark">
        <div class="card-header bg-dark text-white">
            <h5 class="fw-bold mb-0"><i class="bi bi-currency-exchange me-2"></i>Capital by Country</h5>
        </div>
        <div class="card-body">
            <canvas id="capitalChart" height="100"></canvas>
        </div>
    </div>
</div>

<!-- 🌍 Country Detail Table -->
<div class="container mb-5">
    <div class="card shadow-sm border-start border-4 border-dark">
        <div class="card-header bg-dark text-white">
            <h5 class="fw-bold mb-0"><i class="bi bi-globe2 me-2"></i>Detailed Country Overview</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-0">
                    <thead class="table-dark text-white text-center">
                        <tr>
                            <th>Country</th>
                            <th>Clients</th>
                            <th>Accounts</th>
                            <th>Total Capital</th>
                            <th>Average Balance</th>
                            <th>Top Customer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.CountryReports)
                        {
                            <tr class="text-center align-middle">
                                <td class="text-start">
                                    <img src="https://flagcdn.com/32x24/@(row.CountryCode.ToLower()).png" class="me-2 rounded shadow-sm" />
                                    <strong>@row.Country</strong>
                                </td>
                                <td>@row.Clients</td>
                                <td>@row.Accounts</td>
                                <td>@row.Capital.ToString("C0")</td>
                                <td>@row.AverageBalance.ToString("C0")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.TopCustomerName))
                                    {
                                        <div class="fw-semibold">@row.TopCustomerName</div>
                                        <small class="text-muted">@row.TopCustomerBalance?.ToString("C0")</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('capitalChart').getContext('2d');
        const capitalChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.CountryReports.Select(c => c.Country))),
                datasets: [{
                    label: 'Total Capital (kr)',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.CountryReports.Select(c => c.Capital))),
                    backgroundColor: 'rgba(33, 37, 41, 0.7)',
                    borderColor: 'rgba(33, 37, 41, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return value.toLocaleString('sv-SE') + " kr";
                            }
                        }
                    }
                }
            }
        });
    </script>
}
