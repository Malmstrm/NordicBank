@page
@model NordicBank.Pages.Report.IndexModel
@{
    ViewData["Title"] = "Summary Reports";
}

<h3 class="mb-3">👥 Kundaktivitet</h3>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center shadow-sm border-start border-success border-4">
            <div class="card-body">
                <h6 class="text-muted">📅 Aktiva kunder (90 dagar)</h6>
                <h2 class="fw-bold text-success">@Model.CustomerActivity.ActiveCustomers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm border-start border-danger border-4">
            <div class="card-body">
                <h6 class="text-muted">🧊 Inaktiva kunder (12 månader)</h6>
                <h2 class="fw-bold text-danger">@Model.CustomerActivity.InactiveCustomers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm border-start border-primary border-4">
            <div class="card-body">
                <h6 class="text-muted">👥 Nya kunder (30 dagar)</h6>
                <h2 class="fw-bold text-primary">@Model.CustomerActivity.NewCustomers</h2>
            </div>
        </div>
    </div>
</div>

<h2 class="mb-4">📊 Detailed Country Report</h2>

<table class="table table-bordered table-striped shadow-sm">
    <thead class="table-primary">
        <tr>
            <th>Land</th>
            <th>Kunder</th>
            <th>Konton</th>
            <th>Totalt kapital</th>
            <th>Snittsaldo</th>
            <th>Toppkund</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.CountryReports)
        {
            <tr>
                <td>
                    <img src="https://flagcdn.com/32x24/@(row.CountryCode.ToLower()).png" class="me-2" />
                    @row.Country
                </td>
                <td>@row.Clients</td>
                <td>@row.Accounts</td>
                <td>@row.Capital.ToString("C0")</td>
                <td>@row.AverageBalance.ToString("C0")</td>
                <td>
                    @if (row.TopCustomerName != null)
                    {
                        <span class="fw-bold">@row.TopCustomerName</span>

                        <br />
                        <small class="text-muted">@row.TopCustomerBalance?.ToString("C0")</small>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

