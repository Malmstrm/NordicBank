@page
@using System.Text.Json
@model NordicBank.Pages.Report.IndexModel
@{
    ViewData["Title"] = "Summary Reports";
    Layout = "_Dashboard";
}

<!-- 🧭 Hero Section -->
<section class="text-center mt-5 mb-4">
    <h1 class="fw-bold d-flex justify-content-center align-items-center gap-2">
        <i class="bi bi-bar-chart-line"></i> Summary Reports
    </h1>
    <p class="text-muted">Overview of customers, activity and capital per country.</p>
</section>

<!-- 📊 Activity Summary -->
<section class="container mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-start border-4 border-secondary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Active (90 days)</div>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CustomerActivity.ActiveCustomers</h4>
                        </div>
                        <i class="bi bi-calendar-check fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-start border-4 border-secondary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Inactive (12+ months)</div>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CustomerActivity.InactiveCustomers</h4>
                        </div>
                        <i class="bi bi-person-x fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-start border-4 border-secondary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">New Customers (30 days)</div>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CustomerActivity.NewCustomers</h4>
                        </div>
                        <i class="bi bi-person-plus fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 💰 Capital per Country Chart -->
<section class="container mb-5">
    <div class="card border-start border-4 border-secondary shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-currency-exchange"></i> Capital by Country
            </h5>
            <canvas id="capitalChart" height="100"></canvas>
        </div>
    </div>
</section>

<!-- 🌍 Detailed Country Overview -->
<section class="container mb-5">
    <div class="card border-start border-4 border-secondary shadow-sm">
        <div class="card-body p-0">
            <h5 class="fw-bold p-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-globe2"></i> Country Overview
            </h5>
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Country</th>
                            <th>Clients <i class="bi bi-info-circle-fill text-muted" title="Includes all customers with at least one account."></i></th>
                            <th>Accounts <i class="bi bi-info-circle-fill text-muted" title="Total number of accounts (including inactive)."></i></th>
                            <th>Total Capital</th>
                            <th>Average Balance</th>
                            <th>Top Customer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.CountryReports)
                        {
                            <tr class="text-center align-middle">
                                <td class="text-start">
                                    <img src="https://flagcdn.com/32x24/@(row.CountryCode.ToLower()).png" class="me-2 rounded shadow-sm" />
                                    <strong>@row.Country</strong>
                                </td>
                                <td>@row.Clients</td>
                                <td>@row.Accounts</td>
                                <td>@row.Capital.ToString("C0")</td>
                                <td>@row.AverageBalance.ToString("C0")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.TopCustomerName))
                                    {
                                        <div class="fw-semibold">@row.TopCustomerName</div>
                                        <small class="text-muted">@row.TopCustomerBalance?.ToString("C0")</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const ctx = document.getElementById('capitalChart').getContext('2d');
        const capitalChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.CountryReports.Select(c => c.Country))),
                datasets: [{
                    label: 'Total Capital (kr)',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.CountryReports.Select(c => c.Capital))),
                    backgroundColor: 'rgba(33, 37, 41, 0.7)',
                    borderColor: 'rgba(33, 37, 41, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return value.toLocaleString('sv-SE') + " kr";
                            }
                        }
                    }
                }
            }
        });
    </script>
}
