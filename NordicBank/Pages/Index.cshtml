@page
@model IndexModel
@{
    
}

<!-- 🏦 Hero Text Only -->
<div class="container text-center mt-5 mb-3">
    <h1 class="display-5 fw-bold"><i class="bi bi-bank2 me-2"></i>Nordic Bank Overview</h1>
    <p class="lead text-muted">Explore customer and account statistics across countries.</p>
</div>

<!-- 📈 Summary Cards (wrapped in .container for alignment) -->
<div class="container">
    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card bg-white shadow-sm border-start border-4 border-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Total Clients</h6>
                            <h4 class="fw-bold mb-0">@Model.TotalCustomers</h4>
                        </div>
                        <i class="bi bi-people-fill fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-white shadow-sm border-start border-4 border-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Total Accounts</h6>
                            <h4 class="fw-bold mb-0">@Model.TotalAccounts</h4>
                        </div>
                        <i class="bi bi-credit-card fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-white shadow-sm border-start border-4 border-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Total Capital</h6>
                            <h4 class="fw-bold mb-0">@Model.TotalBalance.ToString("C")</h4>
                        </div>
                        <i class="bi bi-currency-exchange fs-2 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🌍 Country Cards -->
<div class="container">
    <div class="row">
        @foreach (var card in Model.CountryOverview)
        {
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card bg-white shadow-sm border-start border-4 border-dark mb-4"
                     style="cursor:pointer;" onclick="loadTopCustomers('@card.Country', '@card.CountryCode')">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-1">Country</h6>
                                <h5 class="fw-bold mb-0">@card.Country</h5>
                            </div>
                            <img src="https://flagcdn.com/48x36/@(card.CountryCode.ToLower()).png"
                                 class="rounded shadow-sm"
                                 alt="@card.Country flag" />
                        </div>
                        <div class="mt-3 small">
                            <p class="mb-1">
                                <i class="bi bi-people-fill me-1"></i>
                                Clients: <strong>@card.Clients</strong>
                            </p>
                            <p class="mb-1">
                                <i class="bi bi-credit-card me-1"></i>
                                Accounts: <strong>@card.Accounts</strong>
                            </p>
                            <p class="mb-0">
                                <i class="bi bi-currency-exchange me-1"></i>
                                Capital: <strong>@card.Capital</strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<!-- 👥 Modal for Top Customers -->
<div class="modal fade" id="topCustomersModal" tabindex="-1" aria-labelledby="topCustomersLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-sm rounded-3">
            <div class="modal-header bg-dark text-white border-bottom-0">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-bold" id="topCustomersLabel">
                    <img id="countryFlagPlaceholder" src="" alt="Country flag" width="32" height="24" class="rounded shadow-sm" />
                    <span>Top 10 – <span id="countryNamePlaceholder">Country</span></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-0" id="topCustomersContent" style="max-height: 500px; overflow-y: auto;">

                <!-- AJAX partial loads here -->
            </div>

            <div class="modal-footer bg-white border-top">
                <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function loadTopCustomers(countryName, countryCode) {
            $.get('?handler=TopCustomersPartial&country=' + countryName, function (data) {
                $('#topCustomersContent').html(data);
                $('#countryNamePlaceholder').text(countryName);
                $('#countryFlagPlaceholder').attr('src', 'https://flagcdn.com/32x24/' + countryCode.toLowerCase() + '.png');
                const modal = new bootstrap.Modal(document.getElementById('topCustomersModal'));
                modal.show();
            });
        }
    </script>
}