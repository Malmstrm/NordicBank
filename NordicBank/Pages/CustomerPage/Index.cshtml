@page
@model NordicBank.Pages.CustomerPage.IndexModel
@{
    ViewData["Title"] = "Customer Overview";
}

<div class="card shadow-sm mt-4 mb-4 border-start border-4 border-dark w-100">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Customer Overview</h5>
        <a asp-page="./Manage" class="btn btn-sm btn-dark">
            <i class="bi bi-person-plus-fill me-1"></i> Create Customer
        </a>
    </div>

    <div class="card-body px-0">
        <!-- 🔍 Search -->
        <form method="get" class="mb-3 px-3">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or city..." />
                <button type="submit" class="btn btn-outline-dark">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>

        <!-- 📋 Table -->
        <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle table-striped mb-0">
                <thead class="table-dark text-center">
                    <tr>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="Id"
                               asp-route-sortOrder="@(Model.SortColumn == "Id" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                ID
                                @if (Model.SortColumn == "Id")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="Name"
                               asp-route-sortOrder="@(Model.SortColumn == "Name" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                Name
                                @if (Model.SortColumn == "Name")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="Adress"
                               asp-route-sortOrder="@(Model.SortColumn == "Adress" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                Address
                                @if (Model.SortColumn == "Adress")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="City"
                               asp-route-sortOrder="@(Model.SortColumn == "City" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                City
                                @if (Model.SortColumn == "City")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="SSN"
                               asp-route-sortOrder="@(Model.SortColumn == "SSN" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                SSN
                                @if (Model.SortColumn == "SSN")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td class="text-center">@c.CustomerId</td>
                            <td>@c.Givenname</td>
                            <td>@c.Streetaddress</td>
                            <td>@c.City</td>
                            <td class="text-end">@c.NationalId</td>
                            <td class="text-center d-flex justify-content-center align-items-center gap-3">
                                <!-- View -->
                                <a asp-page="./Details" asp-route-id="@c.CustomerId"
                                   class="text-dark" title="View Details">
                                    <i class="bi bi-eye-fill fs-5"></i>
                                </a>

                                <!-- Status -->
                                @switch (c.Status)
                                {
                                    case DataAccessLayer.Enums.CustomerStatus.Active:
                                        <i class="bi bi-check-circle-fill text-dark fs-5" title="Active"></i>
                                        break;
                                    case DataAccessLayer.Enums.CustomerStatus.Inactive:
                                        <i class="bi bi-pause-circle-fill text-dark fs-5" title="Inactive"></i>
                                        break;
                                    case DataAccessLayer.Enums.CustomerStatus.Blacklisted:
                                        <i class="bi bi-slash-circle-fill text-dark fs-5" title="Blacklisted"></i>
                                        break;
                                    case DataAccessLayer.Enums.CustomerStatus.Deceased:
                                        <i class="bi bi-x-octagon-fill text-danger fs-5" title="Deceased"></i>
                                        break;
                                    default:
                                        <i class="bi bi-question-circle-fill text-secondary fs-5" title="Unknown"></i>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 📄 Pagination -->
        <nav aria-label="Customer pagination" class="px-3">
            <ul class="pagination justify-content-center mt-3">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link text-dark" asp-page="./Index"
                           asp-route-pageNo="@(Model.CurrentPage - 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-searchTerm="@Request.Query["searchTerm"]">
                            « Previous
                        </a>
                    </li>
                }

                <li class="page-item disabled">
                    <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                </li>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link text-dark" asp-page="./Index"
                           asp-route-pageNo="@(Model.CurrentPage + 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-searchTerm="@Request.Query["searchTerm"]">
                            Next »
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
