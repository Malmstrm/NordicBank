@page
@model NordicBank.Pages.CustomerPage.IndexModel
@{
}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-1"></i>
            Customer View
        </div>
        <a asp-page="./Manage" class="btn btn-primary">Create new customer</a>
    </div>

    <div class="card-body">
        <form method="get">
            <div class="input-group mb-3">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or city..." />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <a asp-page="./Index" asp-route-sortColumn="Id" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Request.Query["searchTerm"]">Id</a>
                    </th>
                    <th>
                        <a asp-page="./Index" asp-route-sortColumn="Name" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Request.Query["searchTerm"]">Name</a>
                    </th>
                    <th>
                        <a asp-page="./Index" asp-route-sortColumn="Adress" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Request.Query["searchTerm"]">Adress</a>
                    </th>
                    <th>
                        <a asp-page="./Index" asp-route-sortColumn="City" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Request.Query["searchTerm"]">City</a>
                    </th>
                    <th>
                        <a asp-page="./Index" asp-route-sortColumn="SSN" asp-route-sortOrder="@(Model.SortOrder == "asc" ? "desc" : "asc")" asp-route-searchTerm="@Request.Query["searchTerm"]">SSN</a>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td>@c.CustomerId</td>
                        <td>@c.Givenname</td>
                        <td>@c.Streetaddress</td>
                        <td>@c.City</td>
                        <td>@c.NationalId</td>
                        <td>
                            <a asp-page="./Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-info">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index"
                               asp-route-pageNo="@(Model.CurrentPage - 1)"
                               asp-route-sortColumn="@Model.SortColumn"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchTerm="@Request.Query["searchTerm"]">
                                Previous
                            </a>
                        </li>
                    }

                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                    </li>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index"
                               asp-route-pageNo="@(Model.CurrentPage + 1)"
                               asp-route-sortColumn="@Model.SortColumn"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchTerm="@Request.Query["searchTerm"]">
                                Next
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </table>
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index"
                           asp-route-pageNo="@(Model.CurrentPage - 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-searchTerm="@Request.Query["searchTerm"]">
                            Previous
                        </a>
                    </li>
                }

                <li class="page-item disabled">
                    <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                </li>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index"
                           asp-route-pageNo="@(Model.CurrentPage + 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-searchTerm="@Request.Query["searchTerm"]">
                            Next
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>