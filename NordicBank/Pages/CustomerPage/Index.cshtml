@page
@model NordicBank.Pages.CustomerPage.IndexModel
@{
    ViewData["Title"] = "Manage Customers";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-4">
        <h2 class="fw-semibold"><i class="bi bi-people-fill me-2"></i>Manage Customers</h2>
        <p class="text-muted mb-0">View, edit, and manage all bank customers.</p>
    </div>

    <!-- 🆕 Create New Customer -->
    <div class="d-flex justify-content-end mb-3">
        <a asp-page="./Manage"
           class="btn btn-dark rounded-4 d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill"></i>
            <span class="fw-semibold">Create Customer</span>
        </a>
    </div>

    <!-- 🔍 Search -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by ID, SSN, city or name..." />
            <button type="submit" class="btn btn-outline-dark">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </form>

    <!-- 👥 Customer List -->
    <div class="card shadow-sm rounded-4 bg-light" style="border: 1px solid #cfd4da;">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-page="./Index" asp-route-sortColumn="Id"
                               asp-route-sortOrder="@(Model.SortColumn == "Id" && Model.SortOrder == "asc" ? "desc" : "asc")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-pageNo="@Model.CurrentPage"
                               class="text-white text-decoration-none">
                                ID
                                @if (Model.SortColumn == "Id")
                                {
                                    <i class="bi @(Model.SortOrder == "asc" ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </a>
                        </th>
                        <th>Name</th>
                        <th>Address</th>
                        <th>City</th>
                        <th>SSN</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td>@c.CustomerId</td>
                            <td>@c.Givenname</td>
                            <td>@c.Streetaddress</td>
                            <td>@c.City</td>
                            <td>@c.NationalId</td>
                            <td>
                                @switch (c.Status)
                                {
                                    case DataAccessLayer.Enums.CustomerStatus.Active:
                                        <i class="bi bi-check-circle-fill text-dark fs-5" title="Active"></i>
                                        break;
                                    case DataAccessLayer.Enums.CustomerStatus.Inactive:
                                        <i class="bi bi-pause-circle-fill text-dark fs-5" title="Inactive"></i>
                                        break;
                                    case DataAccessLayer.Enums.CustomerStatus.Blacklisted:
                                        <i class="bi bi-slash-circle-fill text-dark fs-5" title="Blacklisted"></i>
                                        break;
                                    case DataAccessLayer.Enums.CustomerStatus.Deceased:
                                        <i class="bi bi-x-octagon-fill text-danger fs-5" title="Deceased"></i>
                                        break;
                                    default:
                                        <i class="bi bi-question-circle-fill text-secondary fs-5" title="Unknown"></i>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-page="./Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-dark rounded-3">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-page="./Manage" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-secondary rounded-3">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 📄 Pagination -->
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link text-dark" asp-page="./Index"
                       asp-route-pageNo="@(Model.CurrentPage - 1)"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm">
                        « Previous
                    </a>
                </li>
            }

            <li class="page-item disabled">
                <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
            </li>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link text-dark" asp-page="./Index"
                       asp-route-pageNo="@(Model.CurrentPage + 1)"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm">
                        Next »
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>
