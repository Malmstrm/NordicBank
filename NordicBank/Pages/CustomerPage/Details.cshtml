@page "{id:int}"
@model NordicBank.Pages.CustomerPage.DetailsModel
@{
    ViewData["Title"] = "Customer Details";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-2">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

@{
    var statusMessage = Model.Customer.Status switch
    {
        DataAccessLayer.Enums.CustomerStatus.Inactive => "This customer is inactive. Account creation and transactions are disabled.",
        DataAccessLayer.Enums.CustomerStatus.Deceased => "This customer is marked as deceased. All activity is locked.",
        DataAccessLayer.Enums.CustomerStatus.Blacklisted => "This customer is blacklisted. No further actions are allowed.",
        _ => "This customer has an unknown status."
    };

    var alertClass = Model.Customer.Status switch
    {
        DataAccessLayer.Enums.CustomerStatus.Inactive => "alert-warning",
        DataAccessLayer.Enums.CustomerStatus.Deceased => "alert-danger",
        DataAccessLayer.Enums.CustomerStatus.Blacklisted => "alert-dark",
        _ => "alert-secondary"
    };

    var iconClass = Model.Customer.Status switch
    {
        DataAccessLayer.Enums.CustomerStatus.Inactive => "bi-pause-circle-fill",
        DataAccessLayer.Enums.CustomerStatus.Deceased => "bi-x-octagon-fill",
        DataAccessLayer.Enums.CustomerStatus.Blacklisted => "bi-shield-exclamation",
        _ => "bi-question-circle-fill"
    };
}

@if (Model.Customer.Status != DataAccessLayer.Enums.CustomerStatus.Active)
{
    <div class="alert @alertClass d-flex align-items-center mt-3" role="alert">
        <i class="bi @iconClass me-2"></i>
        @statusMessage
    </div>
}
<!-- Customer Info -->
<div class="card mt-4 shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Customer Overview</h5>
        <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">← Back to list</a>
    </div>

    <div class="card-body">
        <div class="card-body">
        <div class="row">
            <!-- Left: Info -->
            <div class="col-md-6 border-end">
                <div class="text-center mb-3">
                    <img src="https://flagcdn.com/64x48/@(Model.Customer.CountryCode.ToLower()).png"
                         alt="@Model.Customer.Country flag"
                         class="rounded border shadow-sm mb-2" />
                    <h4 class="fw-bold">@Model.Customer.Givenname</h4>
                    <p class="text-muted">Customer ID: <strong>@Model.Customer.CustomerId</strong></p>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Customer.Status)
                        {
                            case DataAccessLayer.Enums.CustomerStatus.Active:
                                <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                                break;
                            case DataAccessLayer.Enums.CustomerStatus.Inactive:
                                <span class="badge bg-warning text-dark"><i class="bi bi-pause-circle-fill me-1"></i> Inactive</span>
                                break;
                            case DataAccessLayer.Enums.CustomerStatus.Blacklisted:
                                <span class="badge bg-dark"><i class="bi bi-slash-circle-fill me-1"></i> Blacklisted</span>
                                break;
                            case DataAccessLayer.Enums.CustomerStatus.Deceased:
                                <span class="badge bg-danger"><i class="bi bi-x-octagon-fill me-1"></i> Deceased</span>
                                break;
                            default:
                                <span class="badge bg-secondary"><i class="bi bi-question-circle-fill me-1"></i> Unknown</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Total Balance</dt>
                    <dd class="col-sm-8 text-primary fw-semibold">@Model.TotalBalance</dd>
                </dl>

                <div class="d-grid mt-3">
                    <button class="btn btn-outline-primary" onclick="loadMoreCustomerInfo(@Model.Customer.CustomerId)">
                        <i class="bi bi-info-circle me-1"></i> Full Info
                    </button>
                </div>
            </div>

            <!-- Right: Actions -->
            <div class="col-md-6 d-flex flex-column justify-content-center align-items-center">
                <div class="d-grid gap-2 w-100 px-3">
                    <a asp-page="./Manage" asp-route-id="@Model.Customer.CustomerId" class="btn btn-primary w-100">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </a>

                    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Customer.CustomerId"
                          onsubmit="return confirm('Are you sure you want to delete this customer?');">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                    </form>

                    <hr class="my-2" />
                    <div class="text-muted small text-center mb-2">Status Actions</div>

                    @if (Model.Customer.Status != DataAccessLayer.Enums.CustomerStatus.Active)
                    {
                        <form method="post" asp-page-handler="Activate" asp-route-id="@Model.Customer.CustomerId">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-check-circle me-1"></i> Activate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Customer.CustomerId">
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="bi bi-x-circle me-1"></i> Deactivate
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Blacklist" asp-route-id="@Model.Customer.CustomerId">
                            <button type="submit" class="btn btn-dark w-100">
                                <i class="bi bi-slash-circle me-1"></i> Blacklist
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Deceased" asp-route-id="@Model.Customer.CustomerId">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-skull-crossbones me-1"></i> Mark Deceased
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Accounts -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-wallet2 me-2"></i>Accounts</h5>
    </div>
    <div class="card-body">
        @if (Model.Account.Count == 0)
        {
            <p class="text-muted">This customer has no accounts </p>
        }
        else
        {
            <table class="table table-hover table-bordered table-striped table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-hash"></i> Account ID</th>
                        <th><i class="bi bi-currency-dollar"></i> Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model.Account)
                    {
                        <tr>
                            <td>
                                    @if (Model.Customer.Status == DataAccessLayer.Enums.CustomerStatus.Active)
                                    {
                                        <a asp-page="/AccountPage/Details"
                                           asp-route-id="@account.AccountId"
                                           asp-route-customerId="@Model.Customer.CustomerId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View account">
                                            <i class="bi bi-eye"></i> @account.AccountId
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled
                                                title="Disabled due to customer status">
                                            <i class="bi bi-eye-slash"></i> @account.AccountId
                                        </button>
                                    }
                            </td>
                            <td>@account.Balance.ToString("C")</td>
                            <td>
                                @if (account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle-fill me-1"></i> Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Create Account -->
        <form method="post" asp-page-handler="CreateAccount" asp-route-customerId="@Model.Customer.CustomerId">
            <div class="row g-2 align-items-end mt-3">
                <div class="col-md-6">
                    <label for="frequency" class="form-label">Frequency</label>
                    <select class="form-select" id="frequency" name="frequency" required>
                        <option value="">-- Select Frequency --</option>
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Yearly">Yearly</option>
                    </select>
                </div>
                <div class="col-md-6 d-grid">
                        <button type="submit" class="btn btn-primary"
                        @(Model.Customer.Status != DataAccessLayer.Enums.CustomerStatus.Active ? "disabled" : "")>
                            <i class="bi bi-plus-circle me-1"></i> Create Account
                        </button>
                </div>
            </div>
        </form>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mt-3">
                Please fix the errors above before continuing.
            </div>
        }
    </div>
</div>

<!-- Transactions -->
<div class="card mb-5">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Latest 10 Transactions</h5>
    </div>
    <div class="card-body">
        @if (Model.Transactions.Count == 0)
        {
            <p class="text-muted">No transactions yet.</p>
        }
        else
        {
            <table class="table table-striped table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Account ID</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td>@t.AccountId</td>
                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                            <td>@t.Type</td>
                            <td>
                                @if (t.Amount >= 0)
                                {
                                    <span class="text-success fw-semibold">
                                        <i class="bi bi-arrow-down-circle me-1"></i> @t.Amount.ToString("C")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-semibold">
                                        <i class="bi bi-arrow-up-circle me-1"></i> @t.Amount.ToString("C")
                                    </span>
                                }
                            </td>
                            <td>@t.Balance.ToString("C")</td>
                            <td>@t.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="customerDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow rounded-3">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Customer Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="customerDetailsContent">
                <!-- AJAX content will load here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadMoreCustomerInfo(customerId) {
            $.get('?handler=MoreInfoPartial&customerId=' + customerId, function (data) {
                $('#customerDetailsContent').html(data);
                var modal = new bootstrap.Modal(document.getElementById('customerDetailsModal'));
                modal.show();
            });
        }
    </script>
}
