@page "{id:int}"
@model NordicBank.Pages.CustomerPage.DetailsModel
@{
    ViewData["Title"] = "Customer Details";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-2">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}
<div class="card mt-4 shadow-sm mb-2">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Customer Information</h5>
        <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">← Back to list</a>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Left Column -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Customer ID</dt>
                    <dd class="col-sm-8">@Model.Customer.CustomerId</dd>

                    <dt class="col-sm-4">First Name</dt>
                    <dd class="col-sm-8">@Model.Customer.Givenname</dd>

                    <dt class="col-sm-4">Last Name</dt>
                    <dd class="col-sm-8">@Model.Customer.Surname</dd>

                    <dt class="col-sm-4">Gender</dt>
                    <dd class="col-sm-8">@Model.Customer.Gender</dd>

                    <dt class="col-sm-4">Birthday</dt>
                    <dd class="col-sm-8">@Model.Customer.Birthday?.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Customer.Status)
                        {
                            case DataAccessLayer.Enums.CustomerStatus.Active:
                                <span class="badge bg-success">✅ Active</span>
                                break;
                            case DataAccessLayer.Enums.CustomerStatus.Inactive:
                                <span class="badge bg-warning text-dark">🛑 Inactive</span>
                                break;
                            case DataAccessLayer.Enums.CustomerStatus.Blacklisted:
                                <span class="badge bg-dark">🚫 Blacklisted</span>
                                break;
                            case DataAccessLayer.Enums.CustomerStatus.Deceased:
                                <span class="badge bg-danger">☠️ Deceased</span>
                                break;
                            default:
                                <span class="badge bg-secondary">Unknown</span>
                                break;
                        }
                    </dd>
                    <dt class="col-sm-4">Total Balace</dt>
                    <dd class="col-sm-8 text-primary fw-semibold">@Model.TotalBalance</dd>
                </dl>
            </div>

            <!-- Right Column -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Street Address</dt>
                    <dd class="col-sm-8">@Model.Customer.Streetaddress</dd>

                    <dt class="col-sm-4">City</dt>
                    <dd class="col-sm-8">@Model.Customer.City</dd>

                    <dt class="col-sm-4">Zip Code</dt>
                    <dd class="col-sm-8">@Model.Customer.Zipcode</dd>

                    <dt class="col-sm-4">Country</dt>
                    <dd class="col-sm-8">@Model.Customer.Country</dd>

                    <dt class="col-sm-4">Country Code</dt>
                    <dd class="col-sm-8">@Model.Customer.CountryCode</dd>

                    <dt class="col-sm-4">National ID</dt>
                    <dd class="col-sm-8">@Model.Customer.NationalId</dd>

                    <dt class="col-sm-4">Telephone</dt>
                    <dd class="col-sm-8">+@Model.Customer.Telephonecountrycode @Model.Customer.Telephonenumber</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Customer.Emailaddress</dd>
                </dl>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-4 d-flex flex-wrap justify-content-end gap-2">
            <a asp-page="./Manage" asp-route-id="@Model.Customer.CustomerId" class="btn btn-primary">✏️ Edit</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Customer.CustomerId" onsubmit="return confirm('Are you sure you want to delete this customer?');">
                <button type="submit" class="btn btn-danger">🗑️ Delete</button>
            </form>
            @if (Model.Customer.Status != DataAccessLayer.Enums.CustomerStatus.Active)
            {
                <form method="post" asp-page-handler="Activate" asp-route-id="@Model.Customer.CustomerId">
                    <button type="submit" class="btn btn-success">✅ Activate</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Customer.CustomerId">
                    <button type="submit" class="btn btn-warning">🛑 Deactivate</button>
                </form>
                <form method="post" asp-page-handler="Blacklist" asp-route-id="@Model.Customer.CustomerId">
                    <button type="submit" class="btn btn-dark">🚫 Blacklist</button>
                </form>
                <form method="post" asp-page-handler="Deceased" asp-route-id="@Model.Customer.CustomerId">
                    <button type="submit" class="btn btn-outline-danger">☠️ Mark Deceased</button>
                </form>
            }
        </div>
    </div>
</div>



<!-- 💼 Kontokort -->
<div class="card mb-2">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Accounts</h5>
        <!-- Account create-formen här -->
    </div>
    <div class="card-body">
        <!-- Kontolistan här -->
        @if(Model.Account.Count == 0)
        {
            <p class="text-muted">This customer has no accounts </p>
        }
        else
        {
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-hash"></i> Account ID</th>
                        <th><i class="bi bi-currency-dollar"></i> Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model.Account)
                    {
                        <tr>
                            <td>
                                <a asp-page="/AccountPage/Details"
                                   asp-route-id="@account.AccountId"
                                   asp-route-customerId="@Model.Customer.CustomerId">
                                    @account.AccountId
                                </a>
                            </td>
                            <td>@account.Balance.ToString("C")</td>
                            <td>
                                @if (account.AccountStatus == DataAccessLayer.Enums.AccountStatus.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- 📥 Skapa nytt konto -->

        <form method="post" asp-page-handler="CreateAccount" asp-route-customerId="@Model.Customer.CustomerId">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label for="frequency" class="form-label">Frequency</label>
                    <select class="form-select" id="frequency" name="frequency" required>
                        <option value="">-- Select Frequency --</option>
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Yearly">Yearly</option>
                    </select>
                </div>
                <div class="col-md-6 d-grid">
                    <button type="submit" class="btn btn-primary">➕ Create New Account</button>
                </div>
            </div>
        </form>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mt-3">
                Please fix the errors above before continuing.
            </div>
        }
        </div>
    </div>

    <!-- 📄 Transaktioner -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Latest 10 Transactions</h5>
        </div>
        <div class="card-body">
            <!-- Transaktionstabellen här -->
        @if (Model.Transactions.Count == 0)
        {
            <p class="text-muted">No transactions yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Account ID</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td>@t.AccountId</td>
                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                            <td>@t.Type</td>
                            <td style="color:@(t.Amount >= 0 ? "green" : "red")">@t.Amount.ToString("C")</td>
                            <td>@t.Balance.ToString("C")</td>
                            <td>@t.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        </div>
    </div>
</div>