@page
@model NordicBank.Pages.UserPage.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-4">
        <h2 class="fw-semibold"><i class="bi bi-people-fill me-2"></i>Manage Users</h2>
        <p class="text-muted mb-0">View, edit, and manage all system users.</p>
    </div>

    <!-- 🆕 Create New User -->
    <div class="d-flex justify-content-end mb-3">
        <a asp-area="Identity" asp-page="/Account/Register"
           class="btn btn-dark rounded-4 d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill"></i>
            <span class="fw-semibold">Register New User</span>
        </a>
    </div>

    <!-- 👥 User List -->
    <div class="card shadow-sm rounded-4 bg-light" style="border: 1px solid #cfd4da;">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th><i class="bi bi-person"></i> Username</th>
                        <th><i class="bi bi-envelope"></i> Email</th>
                        <th><i class="bi bi-shield-lock"></i> Role</th>
                        <th><i class="bi bi-toggle-on"></i> Status</th>
                        <th><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td class="text-center">
                                @if (user.IsActive)
                                {
                                    <i class="bi bi-check-circle-fill text-dark fs-5" title="Active"></i>
                                }
                                else
                                {
                                    <i class="bi bi-pause-circle-fill text-dark fs-5" title="Inactive"></i>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-page="./Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-dark rounded-3">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
