@page
@model NordicBank.Pages.UserPage.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-info-circle me-2"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-4">
        <h2 class="fw-semibold"><i class="bi bi-people-fill me-2"></i>Manage Users</h2>
        <p class="text-muted mb-0">View, edit, and manage all system users.</p>
    </div>

    <!-- 🔍 Search + ➕ Create -->
    <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
        <form method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 400px;">
            <input name="SearchEmail" value="@Model.SearchEmail" class="form-control" placeholder="Search by email..." />
            <button type="submit" class="btn btn-outline-dark">
                <i class="bi bi-search"></i>
            </button>
        </form>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-dark rounded-4 d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill"></i> <span class="fw-semibold">Register New User</span>
        </a>
    </div>

    <!-- 👥 User List -->
    <div class="card shadow-sm rounded-4 bg-light" style="border: 1px solid #cfd4da;">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th><i class="bi bi-person"></i> Username</th>
                        <th><i class="bi bi-envelope"></i> Email</th>
                        <th><i class="bi bi-shield-lock"></i> Role</th>
                        <th><i class="bi bi-toggle-on"></i> Status</th>
                        <th><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.ViewModel.Users)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td class="text-center">
                                @if (user.IsActive)
                                {
                                    <i class="bi bi-check-circle-fill text-dark fs-5" title="Active"></i>
                                }
                                else
                                {
                                    <i class="bi bi-pause-circle-fill text-dark fs-5" title="Inactive"></i>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-page="./Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-dark rounded-3">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id"
                                          onsubmit="return confirm('Toggle active/inactive status for this user?');">
                                        <button type="submit"
                                                class="btn btn-sm rounded-3 @(user.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                                title="@(user.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(user.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id"
                                          onsubmit="return confirm('Are you sure you want to permanently delete this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Delete permanently">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 📄 Pagination -->
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.ViewModel.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link text-dark" asp-page="./Index"
                   asp-route-page="@(Model.ViewModel.CurrentPage - 1)"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-SearchEmail="@Model.SearchEmail">
                    Previous
                </a>
            </li>
            @for (int i = 1; i <= Model.ViewModel.TotalPages; i++)
            {
                <li class="page-item @(i == Model.ViewModel.CurrentPage ? "active" : "")">
                    <a class="page-link text-dark" asp-page="./Index"
                       asp-route-page="@i"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-SearchEmail="@Model.SearchEmail">@i</a>
                </li>
            }
            <li class="page-item @(Model.ViewModel.CurrentPage == Model.ViewModel.TotalPages ? "disabled" : "")">
                <a class="page-link text-dark" asp-page="./Index"
                   asp-route-page="@(Model.ViewModel.CurrentPage + 1)"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-SearchEmail="@Model.SearchEmail">
                    Next
                </a>
            </li>
        </ul>
    </nav>
</div>
