@page
@model NordicBank.Pages.AML.IndexModel
@{
    ViewData["Title"] = "AML Scan History";
}

<div class="card shadow-sm mt-4 mb-4 border-start border-4 border-dark w-100">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-flag me-2"></i>Flagged Transaction Scans
        </h5>
    </div>

    <div class="card-body px-0">
        <form method="get" class="mb-3 px-3">
            <div class="row g-2">
                <div class="col-md-6">
                    <select class="form-select" name="SelectedCountry" asp-for="SelectedCountry" asp-items="Model.CountryOptions">
                        <option value="">-- Select Country --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-outline-dark">
                        <i class="bi bi-search"></i> Filter
                    </button>
                </div>
            </div>
        </form>

        @if (Model.ScanLogs?.Any() != true)
        {
            <div class="px-3">
                <p class="text-success">No logs are available for the selected country.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-sm align-middle table-striped mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Flagged</th>
                            <th>Logged At</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.ScanLogs)
                        {
                            <tr>
                                <td class="text-center">@log.StartDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">@log.EndDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">@log.SuspiciousCount</td>
                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center">
                                        <span>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                        @if (log.CreatedAt == Model.LatestLogDate)
                                        {
                                            <span class="badge bg-success mt-1">Latest</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a asp-page="/AML/Details"
                                       asp-route-country="@log.Country"
                                       asp-route-from="@log.StartDate.ToString("yyyy-MM-dd")"
                                       asp-route-to="@log.EndDate.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm btn-dark">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
