@page
@model NordicBank.Pages.AML.IndexModel
@{
    ViewData["Title"] = "Flagged Transactions";
}

<h1>Flagged Transactions</h1>

<form method="post">
    <div class="mb-3">
        <label for="countrySelect" class="form-label">Select Country</label>
        <select asp-for="SelectedCountry" asp-items="@(new SelectList(Model.Countries))" class="form-select" onchange="this.form.submit()"></select>
    </div>
</form>

@if (Model.ScanLogs.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Suspicious Count</th>
                <th>Logged At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.ScanLogs)
            {
                <tr>
                    <td>@log.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@log.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>@log.SuspiciousCount</td>
                    <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-primary"
                           asp-page="/AML/Details"
                           asp-route-country="@log.Country"
                           asp-route-from="@log.StartDate.ToString("yyyy-MM-dd")"
                           asp-route-to="@log.EndDate.ToString("yyyy-MM-dd")">
                            <i class="fas fa-eye"></i> Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No logs are available for <strong>@Model.SelectedCountry</strong>.
    </div>
}