@page
@model NordicBank.Pages.AML.IndexModel
@{
    ViewData["Title"] = "AML Scan History";
}

<div class="card shadow-sm mt-4 mb-4 border-start border-4 border-dark w-100">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-flag me-2"></i>Flagged Transaction Scans
        </h5>
    </div>

    <div class="card-body px-0">
        <!-- 🔍 Filter by Country -->
        <form method="get" class="mb-3 px-3">
            <div class="input-group">
                <select class="form-select" name="SelectedCountry" asp-for="SelectedCountry" asp-items="Model.CountryOptions">
                    <option value="">-- Select Country --</option>
                </select>
                <button type="submit" class="btn btn-outline-dark">
                    <i class="bi bi-search"></i> Filter
                </button>
            </div>
        </form>

        <!-- 📋 Table -->
        @if (Model.PagedScanLogs?.Any() != true)
        {
            <div class="px-3">
                <p class="text-success">No logs are available for the selected country.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-sm align-middle table-striped mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Flagged</th>
                            <th>Logged At</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.PagedScanLogs)
                        {
                            <tr>
                                <td class="text-center">@log.StartDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">@log.EndDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">@log.SuspiciousCount</td>
                                <td class="text-center">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-center">
                                    <a asp-page="/AML/Details"
                                       asp-route-country="@log.Country"
                                       asp-route-from="@log.StartDate.ToString("yyyy-MM-dd")"
                                       asp-route-to="@log.EndDate.ToString("yyyy-MM-dd")"
                                       class="text-dark" title="View Details">
                                        <i class="bi bi-eye-fill fs-5"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 📄 Pagination -->
            <nav aria-label="ScanLog pagination" class="px-3">
                <ul class="pagination justify-content-center mt-3">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link text-dark" asp-page="./Index"
                               asp-route-SelectedCountry="@Model.SelectedCountry"
                               asp-route-pageNo="@(Model.CurrentPage - 1)">
                                « Previous
                            </a>
                        </li>
                    }

                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                    </li>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link text-dark" asp-page="./Index"
                               asp-route-SelectedCountry="@Model.SelectedCountry"
                               asp-route-pageNo="@(Model.CurrentPage + 1)">
                                Next »
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>